# Copiar a Variables de entorno del proyecto Vercel (Production + Preview).
# Cada variable en su propia línea (no concatenar).

# --- Job store (obligatorio en Vercel) ---
JOB_STORE_BACKEND=vercel_blob
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
JOB_TTL_DAYS=7
JOB_INLINE_RESULT_MAX_BYTES=2097152
LOCK_TTL_SECONDS=900
# false = generate/finalize nunca se bloquean entre sí (recomendado mientras PA valida idempotencia)
PAYMENT_VALIDATION_LOCKS_ENABLED=false
BLOB_HTTP_MAX_RETRIES=3
BLOB_HTTP_RETRY_BASE_SECONDS=0.5
BLOB_HTTP_RETRY_MAX_SECONDS=4

# --- Runner: workflows + fallback API si el worker no ejecuta el step ---
JOB_RUNNER_BACKEND=vercel_workflow
VERCEL_WORKFLOWS_ENABLED=true
WORKFLOW_AMORTIZATION_DRY_RUN_NAME=amortization_dry_run_workflow
WORKFLOW_AMORTIZATION_APPLY_NAME=amortization_apply_workflow
WORKFLOW_VALIDATE_PAYMENT_REPORT_NAME=validate_payment_report_workflow
WORKFLOW_NOTIFY_VALIDAR_EXTRACTOS_NAME=notify_validar_extractos_workflow
WORKFLOW_MERGE_COMPOSITE_VALIDADO_PDFS_NAME=merge_composite_validado_pdfs_workflow
WORKFLOW_ENSURE_ASIENTOS_CONTABLES_NAME=ensure_asientos_contables_workflow
WORKFLOW_PAYMENT_VALIDATION_GENERATE_NAME=payment_validation_generate_workflow
WORKFLOW_PAYMENT_VALIDATION_FINALIZE_NAME=payment_validation_finalize_workflow
WORKFLOW_PING_NAME=workflow_ping_workflow
# Si el worker no avanza el job en ~12s, la API ejecuta el mismo job (como Render)
VERCEL_WORKFLOW_API_FALLBACK=true
VERCEL_WORKFLOW_API_FALLBACK_DELAY_SECONDS=12

# Alternativa temporal (sin Workflows): solo BackgroundTasks en la API
# JOB_RUNNER_BACKEND=background
# VERCEL_WORKFLOWS_ENABLED=false

# --- Microsoft Graph (mismos valores que Render) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SHAREPOINT_SITE_SEARCH=
GRAPH_SHAREPOINT_DRIVE_NAME=
GRAPH_SHAREPOINT_FILE_PATH=

# Copiar el resto de GRAPH_* desde Render (generate, finalize, merge, notify)
GRAPH_BANK_PAYMENTS_FILE_PATH=
GRAPH_CLIENTS_BASE_PATH=
GRAPH_PAYMENT_VALIDATION_REVIEW_PATH=
GRAPH_PAYMENT_VALIDATION_HISTORY_PATH=
GRAPH_VALIDATION_FILE_PREFIX=
GRAPH_PAYMENT_VALIDATION_CONTROL_PATH=
GRAPH_PAYMENT_VALIDATION_LOGS_PATH=
GRAPH_MERGE_CONTROL_WORKBOOK_PATH=
GRAPH_VALIDAR_EXTRACTO_ESTADO_CONTAINS=VALIDAR
GRAPH_VALIDAR_NOTIFY_CORREOS_XLSX_PATH=
GRAPH_MAIL_SENDER_EMAIL=
GRAPH_MAIL_TO=
GRAPH_MAIL_CC=
