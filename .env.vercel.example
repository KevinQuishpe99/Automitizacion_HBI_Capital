# Copiar a Variables de entorno del proyecto Vercel (Production + Preview).
# Cada variable en su propia línea (no concatenar).

# --- Job store (obligatorio en Vercel) ---
JOB_STORE_BACKEND=vercel_blob
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
JOB_TTL_DAYS=7
JOB_INLINE_RESULT_MAX_BYTES=2097152
LOCK_TTL_SECONDS=900
BLOB_HTTP_MAX_RETRIES=3
BLOB_HTTP_RETRY_BASE_SECONDS=0.5
BLOB_HTTP_RETRY_MAX_SECONDS=4

# --- Runner: workflows + fallback API si el worker no ejecuta el step ---
JOB_RUNNER_BACKEND=vercel_workflow
VERCEL_WORKFLOWS_ENABLED=true
WORKFLOW_AMORTIZATION_DRY_RUN_NAME=amortization_dry_run_workflow
WORKFLOW_PING_NAME=workflow_ping_workflow
# Si el worker no avanza el job en ~12s, la API ejecuta el mismo job (como Render)
VERCEL_WORKFLOW_API_FALLBACK=true
VERCEL_WORKFLOW_API_FALLBACK_DELAY_SECONDS=12

# Alternativa temporal (sin Workflows): solo BackgroundTasks en la API
# JOB_RUNNER_BACKEND=background
# VERCEL_WORKFLOWS_ENABLED=false

# --- Microsoft Graph (mismos valores que Render) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SHAREPOINT_SITE_SEARCH=
GRAPH_SHAREPOINT_FILE_PATH=
