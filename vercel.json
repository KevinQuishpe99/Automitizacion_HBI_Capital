{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "services",
  "installCommand": "pip install .",
  "experimentalServices": {
    "api": {
      "framework": "fastapi",
      "entrypoint": "index.py",
      "routePrefix": "/",
      "maxDuration": 60,
      "memory": 2048
    },
    "workflows": {
      "type": "worker",
      "entrypoint": "app/workflows/index.py",
      "topics": ["__wkf_*"]
    }
  }
}
