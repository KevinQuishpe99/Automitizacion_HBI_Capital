{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pip install -r requirements.txt",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "experimentalServices": {
    "amortization_dry_run": {
      "type": "worker",
      "entrypoint": "app/workflows/amortization_dry_run_workflow.py",
      "topics": ["__wkf_*"]
    }
  }
}
